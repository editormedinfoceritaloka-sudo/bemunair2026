# App Config
PUBLIC_APP_NAME=BEM UNAIR
PORT=3000

# Internal API addresses used only by the SvelteKit server
API_INTERNAL_URL=http://server:8080/api/v1
WA_INTERNAL_URL=http://wa-engine:3001

# ImageKit server-side upload
# Keep the private key secret. Never prefix it with PUBLIC_.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_UPLOAD_FOLDER=/bemunair
IMAGEKIT_MAX_UPLOAD_BYTES=10485760
