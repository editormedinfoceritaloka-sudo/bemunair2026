# Image release. GitHub Actions menulis nilai ini ke .release.env.
SERVER_IMAGE=ghcr.io/owner/repository-server:sha-commit
CLIENT_IMAGE=ghcr.io/owner/repository-client:sha-commit
WA_ENGINE_IMAGE=ghcr.io/owner/repository-wa-engine:sha-commit

# Untuk reproduktibilitas maksimum, ganti tag image infrastruktur dengan digest.
MYSQL_IMAGE=mysql:8.0
NGINX_IMAGE=nginx:alpine

TZ=Asia/Jakarta
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081

MYSQL_DATABASE=bemunair_db
MYSQL_USER=bemunair
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password
DB_MAX_OPEN=20
DB_MAX_IDLE=10

JWT_SECRET=replace_with_at_least_32_random_bytes
CORS_ALLOWED_ORIGINS=https://bem.example.org
APP_ORIGIN=https://bem.example.org
ADMIN_DASHBOARD_URL=https://bem.example.org/admin
PUBLIC_APP_NAME=BEM UNAIR

WA_ENGINE_API_KEY=replace_with_a_long_random_internal_key
WA_AUTO_CONNECT=true
WA_SENDER_PHONE=628xxxxxxxxxx
WA_GROUP_JID_1=
WA_GROUP_JID_2=

IMAGEKIT_PUBLIC_KEY=replace_with_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=replace_with_imagekit_private_key
IMAGEKIT_UPLOAD_FOLDER=/bemunair
IMAGEKIT_MAX_UPLOAD_BYTES=20971520
IMAGEKIT_MAX_IMAGE_BYTES=20971520
IMAGEKIT_MAX_BRIEF_BYTES=15728640
