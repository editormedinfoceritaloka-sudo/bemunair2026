APP_ENV=development
PORT=8080
TZ=Asia/Jakarta

DB_HOST=bemunair_db
DB_PORT=3306
DB_NAME=bemunair_db
DB_USER=bemunair
DB_PASSWORD=bemunair_password
DB_MAX_OPEN=20
DB_MAX_IDLE=10

JWT_SECRET=change_me
# Shared dev-login password for every account created by
# database/seeders/001_users.sql. Dev-only: production never runs the
# seeder. Required only when actually running `go run ./cmd seed` or `setup`.
SEED_USER_PASSWORD=change_me
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

WA_ENGINE_URL=http://bemunair_wa_engine:3001
WA_ENGINE_API_KEY=change_me_same_as_wa_engine
WA_GROUP_JID_1=120363xxxxxxxx@g.us
WA_GROUP_JID_2=120363yyyyyyyy@g.us
# URL publik halaman admin; kosongkan di lokal agar pesan tidak memuat tautan localhost.
ADMIN_DASHBOARD_URL=https://admin.example.org/admin
DOCS_DIR=/docs/api
