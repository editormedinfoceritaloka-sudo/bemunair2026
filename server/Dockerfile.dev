FROM golang:1.25-bookworm

WORKDIR /app

ENV CGO_ENABLED=0
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOTOOLCHAIN=local

# Versi Air yang kompatibel dengan Go 1.25
RUN go install github.com/air-verse/air@v1.66.1

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=10 \
  CMD bash -c 'echo -e "GET /ping HTTP/1.0\r\n\r\n" > /dev/tcp/127.0.0.1/8080' || exit 1

CMD ["air", "-c", ".air.toml"]
